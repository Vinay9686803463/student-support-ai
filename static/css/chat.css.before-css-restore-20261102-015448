/* Chat CSS - Clean Light Theme */

.chat-page {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    height: calc(100vh - 140px);
    overflow: hidden;
    margin: 24px 32px;
}

.chat-header {
    padding: 16px 24px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-header-info h2 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
}

.chat-header-info p {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
}

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.chat-message {
    display: flex;
    gap: 12px;
    max-width: 80%;
}

.chat-message.user {
    align-self: flex-end;
    flex-direction: row-reverse;
}

.chat-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--primary);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    flex-shrink: 0;
}

.chat-bubble {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 12px 16px;
    border-radius: var(--radius);
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
}

.chat-message.user .chat-bubble {
    background: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
}

.chat-input-area {
    padding: 16px 24px;
    background: var(--card);
    border-top: 1px solid var(--border);
    display: flex;
    gap: 12px;
    align-items: flex-end;
}

.chat-input-box {
    flex: 1;
    border: 1px solid var(--input-border);
    border-radius: var(--radius);
    background: var(--card);
    overflow: hidden;
}

.chat-input-box:focus-within {
    border-color: var(--primary);
    box-shadow: var(--focus-ring);
}

.chat-input-box textarea {
    width: 100%;
    border: none;
    padding: 12px;
    resize: none;
    max-height: 120px;
    font-size: 14px;
    background: transparent;
    color: var(--text);
}

.chat-input-box textarea:focus {
    outline: none;
}

.chat-send-btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: var(--radius);
    flex-shrink: 0;
}

.suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 24px 12px;
    background: var(--card);
}

.suggestions button {
    padding: 8px 12px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
}

.suggestions button:hover {
    background: var(--surface-hover);
    border-color: var(--primary);
    color: var(--primary);
}

.followup-suggestions {
    margin: 12px 0 16px 48px;
}

.followup-label {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 12px;
}

.followup-suggestions .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    background: transparent;
}

@keyframes library-spin-animation {
    to {
        transform: rotate(360deg);
    }
}

/* Retry button */
.library-retry-btn {
    padding: 9px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
}

.followup-suggestions .suggestion-chip:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--surface-hover);
}

.typing {
    display: flex;
    gap: 4px;
    padding: 12px 16px;
}

.typing span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
    animation: typing 1.4s infinite;
}

.typing span:nth-child(2) {
    animation-delay: 0.2s;
}

.typing span:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes typing {
    0%, 60%, 100% {
        opacity: 0.3;
    }
    30% {
        opacity: 1;
    }
}

@media (max-width: 650px) {
    .chat-page {
        margin: 16px;
        height: calc(100vh - 120px);
    }
    .followup-suggestions {
        margin-left: 0;
    }

    .ai-message .message-content h3 {
        font-size: 17px;
    }

    .ai-message .message-content pre {
        white-space: pre;
    }

    .ai-message .message-content div.math-display {
        text-align: left;
    }
}

/* ============================================================
   REFERENCE REDESIGN LAYER — vtudeveloper.in (chat surface)
   Chat-specific theme, loaded last so it wins the cascade for
   message bubbles, input, chips and buttons.
   ============================================================ */

/* Assistant bubble: layered dark card with blue-tinted border. */
.ai-message .message-content {
    background:
        linear-gradient(180deg, rgba(59, 130, 246, 0.06), rgba(255, 255, 255, 0.015) 44%),
        #08080d;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
}

/* User bubble: the reference blue→cyan button gradient. */
.user-message .message-content {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    border-color: transparent;
    border-radius: 14px;
    box-shadow: 0 10px 26px rgba(59, 130, 246, 0.35);
}

/* Assistant name row tone inside bubbles. */
.ai-message .message-content > strong {
    color: #93c5fd;
}

/* Chat content: keep readable aria of the reference body text. */
.message-content p,
.message-content li {
    color: rgba(255, 255, 255, 0.85);
}

.message-content pre {
    background: #000000;
    border-color: rgba(255, 255, 255, 0.08);
}

.message-content code { color: #93c5fd; }

.message-content th, .message-content td {
    border-color: rgba(255, 255, 255, 0.08);
}

.message-content th {
    background: rgba(59, 130, 246, 0.10);
    color: #93c5fd;
}

.message-content blockquote {
    background: rgba(59, 130, 246, 0.06);
    border-left-color: var(--primary);
    color: rgba(255, 255, 255, 0.75);
}

/* Starter + follow-up suggestion chips. */
.suggestions button,
.followup-suggestions .suggestion-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    border-radius: 10px;
}

.suggestions button:hover,
.followup-suggestions .suggestion-chip:hover {
    background: rgba(59, 130, 246, 0.10);
    border-color: rgba(59, 130, 246, 0.45);
    color: var(--primary-light);
}

/* Input chrome = reference search pill. */
.chat-input-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
}

.chat-input-box textarea { color: #ffffff; }

.chat-input-box textarea::placeholder {
    color: rgba(255, 255, 255, 0.3);
}

.send-button {
    background: linear-gradient(135deg, #7c3aed 0%, #3b82f6 55%, #06b6d4 100%);
    border-radius: 50%;
    box-shadow:
        0 4px 14px rgba(59, 130, 246, 0.45),
        0 0 0 4px rgba(255, 255, 255, 0.06);
}

.send-button:disabled {
    opacity: 0.55;
    filter: none;
    box-shadow: none;
}

.stop-button {
    background: #ef4444 !important;
    border-radius: 50%;
}