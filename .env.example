# Optional: omit this file to run with a local SQLite database automatically.
# DATABASE_URL=postgresql://user:password@host:port/database_name

# Use a long, random value when deploying with PostgreSQL.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: Google Gemini API key for richer AI chat answers.
# Get one free at https://aistudio.google.com/apikey
# Leave it unset (or as the placeholder below) to use the built-in
# offline study assistant instead — the app works fully either way.
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_API_KEY_HERE

# Nextcloud (local) — Student Support AI folder automation.
# Copy this file to `.env` and fill in the real app password locally.
# Never commit the real `.env` (it is git-ignored). Placeholders only here.
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USERNAME=1DI24CS087
NEXTCLOUD_APP_PASSWORD=your-app-password-here

# AI provider selection for chat answers. One of: gemini (default,
# free-tier eligible), openai (paid API), ollama (free local inference).
# Only the selected provider's credentials are required.
AI_PROVIDER=gemini

# Optional: override the Gemini model list (comma-separated, tried in
# order). Defaults are the verified free-tier Flash models.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Optional: OpenAI key and model — needed only when AI_PROVIDER=openai.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-4o-mini

# Optional: local Ollama server — needed only when AI_PROVIDER=ollama.
# No API key required. Install Ollama, run `ollama serve`, then e.g.
# `ollama pull llama3.1:8b` before starting the backend.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
